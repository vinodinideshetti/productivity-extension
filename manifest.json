{
    "manifest_version": 3,
    "name": "Productivity Manager",
    "version": "1.0",
    "description": "Tracks time, blocks distractions, and gives productivity reports.",
    "permissions": ["storage", "tabs", "webNavigation", "activeTab", "scripting"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "host_permissions": ["<all_urls>"]
  }
  